<?xml version="1.0"?>
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="config_file" default="two_wheel_controllers.yaml"/>
  <xacro:arg name="robot_namespace" default=""/>

  <!-- ================= PARAMETERS ================= -->
  <xacro:property name="chassis_length" value="0.40"/>
  <xacro:property name="chassis_width"  value="0.30"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="5.0"/>

  <xacro:property name="wheel_radius"   value="0.05"/>
  <xacro:property name="wheel_width"    value="0.04"/>
  <xacro:property name="wheel_mass"     value="0.5"/>
  <xacro:property name="wheel_y_offset" value="0.18"/>

  <xacro:property name="caster_radius"  value="0.05"/>
  <xacro:property name="caster_mass"    value="0.2"/>
  <xacro:property name="caster_x_offset" value="0.17"/>

  <xacro:property name="lidar_radius"   value="0.04"/>
  <xacro:property name="lidar_height"   value="0.05"/>

  <xacro:property name="camera_size"    value="0.02"/>
  <xacro:property name="chassis_z_offset" value="0.015"/>

  <material name="chassis_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="lidar_red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="camera_blue"><color rgba="0.1 0.1 0.9 1.0"/></material>

  <!-- ================= INERTIA MACROS ================= -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass/12.0*(y*y+z*z)}" ixy="0.0" ixz="0.0"
             iyy="${mass/12.0*(x*x+z*z)}" iyz="0.0"
             izz="${mass/12.0*(x*x+y*y)}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertia ixx="${mass/12.0*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
             iyy="${mass/12.0*(3*r*r+h*h)}" iyz="0.0"
             izz="${mass/2.0*r*r}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass r">
    <inertia ixx="${2.0/5.0*mass*r*r}" ixy="0.0" ixz="0.0"
             iyy="${2.0/5.0*mass*r*r}" iyz="0.0"
             izz="${2.0/5.0*mass*r*r}"/>
  </xacro:macro>

  <!-- ================= BASE LINK ================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ================= DRIVE WHEEL MACRO ================= -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect mu1:=1.0 mu2:=1.0">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect*0.14} ${y_reflect*wheel_y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"  mu1="1.0" mu2="1.0"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"  mu1="1.0" mu2="0.05"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1" mu1="1.0" mu2="1.0"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1" mu1="1.0" mu2="0.05"/>

  <!-- ================= LIDAR (top) ================= -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="lidar_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:cylinder_inertia mass="0.1" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + lidar_height/2 + chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/$(arg robot_namespace)/scan</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>270</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <gz_frame_id>$(arg robot_namespace)/lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================= CAMERA (front) ================= -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${camera_size} ${camera_size} ${camera_size}"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${camera_size} ${camera_size} ${camera_size}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:box_inertia mass="0.05" x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2} 0 ${chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- optical frame, REP-103 convention -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/$(arg robot_namespace)/camera/image_raw</topic>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <gz_frame_id>$(arg robot_namespace)/camera_optical_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- ================= IMU ================= -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:box_inertia mass="0.01" x="0.02" y="0.02" z="0.01"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>/$(arg robot_namespace)/imu</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>$(arg robot_namespace)/imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================= ros2_control (diff drive) ================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <static_update_frequency>50</static_update_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find amr_leader_follower)/config/$(arg config_file)</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <ros>
        <namespace>/$(arg robot_namespace)</namespace>
        <remapping>tf:=/tf</remapping>
        <remapping>tf_static:=/tf_static</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>
